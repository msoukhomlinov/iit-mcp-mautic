{
    "name": "intellectit/mautic-mcp-bundle",
    "description": "Model Context Protocol (MCP) server for Mautic: lets Claude, ChatGPT and other MCP clients read contacts, segments, emails and campaigns, write brand emails and campaign drafts, create and update contacts, companies, fields and segments, with the user's Mautic permissions. OAuth 2.1 via kopexa/mautic-oauth-bundle.",
    "type": "mautic-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "mautic",
        "plugin",
        "mcp",
        "model-context-protocol",
        "ai",
        "claude",
        "chatgpt"
    ],
    "homepage": "https://github.com/msoukhomlinov/mautic-mcp-bundle",
    "support": {
        "issues": "https://github.com/msoukhomlinov/mautic-mcp-bundle/issues",
        "source": "https://github.com/msoukhomlinov/mautic-mcp-bundle",
        "security": "https://github.com/msoukhomlinov/mautic-mcp-bundle/security/policy"
    },
    "authors": [
        {
            "name": "IntellectIT",
            "homepage": "https://intellectit.com.au"
        },
        {
            "name": "Kopexa (original author)",
            "homepage": "https://kopexa.com"
        }
    ],
    "extra": {
        "install-directory-name": "IntellectItMcpBundle"
    },
    "require": {
        "php": "~8.4",
        "mautic/core-lib": "^7.2",
        "kopexa/mautic-oauth-bundle": "^0.4",
        "mcp/sdk": "^0.9",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/psr7": "^2.7",
        "symfony/cache": "^7.4"
    },
    "minimum-stability": "stable"
}
